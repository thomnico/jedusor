# Jedusor Configuration Template
# Copy this file to .env and fill in your values

# Required: Claude API key
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Claude model (default: claude-sonnet-4-20250514)
# JEDUSOR_MODEL=claude-sonnet-4-20250514

# Optional: Handwriting recognition backend (default: google)
# JEDUSOR_RECOGNITION=google

# Optional: Startup mode (default: journal)
# JEDUSOR_MODE=journal

# Logging level (default: info)
# RUST_LOG=info
